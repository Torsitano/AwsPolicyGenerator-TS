{
    "name": "awspolicygenerator-ts",
    "version": "0.2.0",
    "description": "Build AWS IAM policies by resource type and access level",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "bin": { "iam-policy": "./dist/cli.js" },
    "files": ["dist", "data"],
    "engines": { "node": ">=22" },
    "scripts": {
        "build": "tsc",
        "test": "npm run build && node --test test/policy.test.cjs",
        "prepack": "npm run build",
        "catalog": "cargo run --locked --manifest-path tools/catalog/Cargo.toml --"
    },
    "license": "ISC",
    "devDependencies": {
        "@types/node": "^22.0.0",
        "typescript": "^5.9.3"
    },
    "dependencies": {
        "aws-cdk-lib": "^2.276.0",
        "yaml": "^2.9.1"
    }
}
